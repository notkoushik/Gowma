{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:api": "esbuild server/apiEntry.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "build": "node scripts/db-deploy.js && npm run build:api && vite build",
    "preview": "vite preview",
    "format": "oxfmt src",
    "test": "node --test scripts/test-authorization-policy.mjs scripts/test-hold-booking-contracts.mjs scripts/test-p1-contracts.mjs scripts/test-password-security.mjs scripts/test-razorpay-security.mjs scripts/test-role-isolation-contracts.mjs scripts/test-skeleton-and-storage-contracts.mjs",
    "test:integration": "node scripts/test-superadmin-context-switch.mjs && node scripts/verify-entire-system.mjs && node scripts/test-registration-and-recovery.mjs && node scripts/test-dynamic-hubs.mjs && node scripts/test-gaushala-map-search.mjs",
    "test:crawler": "node scripts/test-full-application-crawler.mjs",
    "test:crawler:watch": "node scripts/test-full-application-crawler.mjs --headed",
    "test:watch": "python Testing/watch_all_roles.py --all",
    "test:watch:admin": "python Testing/watch_all_roles.py --role admin",
    "test:watch:superadmin": "python Testing/watch_all_roles.py --role super_admin",
    "test:watch:manager": "python Testing/watch_all_roles.py --role manager",
    "test:watch:customer": "python Testing/watch_all_roles.py --role customer",
    "test:watch:driver": "python Testing/watch_all_roles.py --role driver",
    "test:vitest": "vitest run",
    "test:all": "npm run test:vitest && npm test && npm run test:integration",
    "test:rage": "python Testing/test_full_rage_financial_lifecycle.py",
    "docs:screenshots": "node scripts/capture-docs-screenshots.mjs",
    "docs:generate": "node scripts/generate-doc.mjs && node scripts/generate-html-doc.mjs",
    "db:reset-superadmin": "node scripts/reset-to-superadmin-only.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "@types/leaflet": "^1.9.22",
    "esbuild": "^0.28.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "nodemailer": "^10.1.1",
    "postcss": "^8.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.0",
    "docx": "^9.13.0",
    "oxfmt": "^0.2.0",
    "prisma": "6.4.1",
    "puppeteer-core": "^25.15.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.5"
  }
}
