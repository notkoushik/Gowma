# GOMAA Environment Variables Template
# Copy this file to .env and configure with your local settings.

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/gomaa_db?schema=public"

# CARTO Basemaps API Keys (Optional - OpenStreetMap works automatically if unset)
# VITE_CARTO_API_KEY="your_carto_organization_key_here"
# VITE_CARTO_BACKUP_KEY="your_carto_backup_key_here"

# Commission wallet payouts. Leave unset to stay in sandbox mode (no real money moves).
# GOMAA_PAYOUT_MODE=razorpayx
# GOMAA_PAYOUT_PROVIDER_ENABLED=true
# RAZORPAYX_KEY_ID=
# RAZORPAYX_KEY_SECRET=
# RAZORPAYX_ACCOUNT_NUMBER=
# RAZORPAYX_WEBHOOK_SECRET=
# GOMAA_PAYOUT_ACCOUNT_COOLOFF_HOURS=24
# Secret that protects GET /api/jobs/settlement-maturity (scheduled job)
# CRON_SECRET=
# Key used to encrypt saved bank account numbers (falls back to the JWT secret)
# GOMAA_DATA_KEY=

# MSG91 SMS. Indian rules need every SMS to use a DLT-approved template, so each message has its own id.
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=                  # login / password-reset code (OTP template, uses ##OTP##)
# MSG91_TEMPLATE_WITHDRAWAL_OTP=      # withdrawal confirmation code (OTP template, uses ##OTP##)
# MSG91_TEMPLATE_EARNINGS=            # "Rs.{#var#} credited to your wallet for booking {#var#}"
# MSG91_TEMPLATE_WITHDRAWAL_PAID=     # "Rs.{#var#} sent to {#var#}. Bank ref {#var#}"
# MSG91_TEMPLATE_WITHDRAWAL_FAILED=   # "Your withdrawal of Rs.{#var#} failed and was returned"
# MSG91_TEMPLATE_PAYOUT_ACCOUNT=      # "A payout account was {#var#} on your wallet"

# MSG91 WhatsApp: integrated number, and the namespace shown on the WhatsApp > Templates page
MSG91_WHATSAPP_NUMBER=
MSG91_WHATSAPP_NAMESPACE=
# MSG91 email: verified domain, from address, and the template id (variables ##name##, ##title##, ##message##)
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_FROM=
MSG91_EMAIL_TEMPLATE_ID=
# Optional MSG91 SMS templates for booking messages (email and WhatsApp work without them)
MSG91_TEMPLATE_BOOKING_PLACED=
MSG91_TEMPLATE_BOOKING_REVIEW=
MSG91_TEMPLATE_BOOKING_CONFIRMED=
MSG91_TEMPLATE_BOOKING_REJECTED=

MSG91_WHATSAPP_OTP_TEMPLATE=
# GOMAA_WITHDRAWAL_OTP_SMS=true sends the withdrawal code by SMS too (needs DLT-approved templates)
GOMAA_WITHDRAWAL_OTP_SMS=

# Testing only: release earnings immediately (0). Remove for production so the wallet setting (2 days) applies.
# GOMAA_SETTLEMENT_DELAY_DAYS=0
# WhatsApp authentication template used for the login / password-reset code (falls back to MSG91_WHATSAPP_OTP_TEMPLATE)
# MSG91_WHATSAPP_LOGIN_OTP_TEMPLATE=
