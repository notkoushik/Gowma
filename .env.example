# GOMAA Environment Variables Template
# Copy this file to .env and configure with your local settings.

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/gomaa_db?schema=public"

# CARTO Basemaps API Keys (Optional - OpenStreetMap works automatically if unset)
# VITE_CARTO_API_KEY="your_carto_organization_key_here"
# VITE_CARTO_BACKUP_KEY="your_carto_backup_key_here"
