// GOMAA Master Relational Database Schema
// Normalized 3NF Architecture & Anti-Corruption Shield for Booking Operations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// Enums
// -------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  GOSALA_MANAGER
  DRIVER
  CUSTOMER
}

enum BookingStatus {
  PAYMENT_VERIFIED
  MANAGER_REVIEW
  MANAGER_CONFIRMED
  ADMIN_REVIEW
  CONFIRMED
  IN_SERVICE
  COMPLETED
  REJECTED
  CANCELLED
}

enum AnimalType {
  COW
  CALF
  BULL
  BUFFALO
  COW_AND_CALF
}

enum HealthStatus {
  HEALTHY
  RESTING
  MEDICAL_ATTENTION
  INACTIVE
}

enum SettlementStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
}

enum AuditAction {
  CREATED
  MANAGER_CONFIRMED
  MANAGER_REJECTED
  ADMIN_CONFIRMED
  ADMIN_REJECTED
  DRIVER_ASSIGNED
  STAGE_ADVANCED
  SLOT_BLOCKED
  SLOT_UNBLOCKED
  HANDOVER_VERIFIED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionPurpose {
  TOPUP
  BOOKING_PAYMENT
  BOOKING_REFUND
  GAUSHALA_SETTLEMENT
  CASHBACK
  ADJUSTMENT
  ESCROW_IN
  ESCROW_OUT
  TAX_COLLECTED
  PLATFORM_FEE
  SETTLEMENT_RELEASE
  WITHDRAWAL_HOLD
  WITHDRAWAL_PAID
  WITHDRAWAL_REVERSAL
}

enum WalletKind {
  USER
  ESCROW
  PLATFORM
  TAX
  WITHDRAWAL_HOLD
}

enum BookingSettlementStatus {
  HELD
  READY_FOR_APPROVAL
  RELEASED
  REJECTED
  REFUNDED
}

enum SplitRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutAccountType {
  BANK
  UPI
}

enum WithdrawalStatus {
  PROCESSING
  PAID
  FAILED
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

// -------------------------------------------------------------
// Core Identity & Directory
// -------------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  uniqueId  String?  @unique
  email     String   @unique
  name      String
  phone     String
  role      UserRole
  password  String?
  avatar    String?
  isActive  Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  customerBookings   Booking[]                 @relation("CustomerBookings")
  driverBookings     Booking[]                 @relation("DriverBookings")
  managerAssignments GosalaManagerAssignment[]
  auditTrails        ApprovalAuditTrail[]
  createdBlocks      AnimalScheduleBlock[]
  createdHolds       TemporarySlotHold[]
  wallet             Wallet?

  @@index([email])
  @@index([uniqueId])
  @@index([role])
  @@map("users")
}

model Gosala {
  id           String   @id @default(uuid())
  name         String   @unique
  region       String
  address      String
  contactPhone String
  contactEmail String
  latitude     Float?
  longitude    Float?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Governing Operations Admin
  adminId    String?
  adminEmail String?
  adminName  String?

  // Custom Pricing & Offerings
  baseCowPrice     Int? @default(3500)
  baseBullPrice    Int? @default(4000)
  baseCalfPrice    Int? @default(2500)
  baseBuffaloPrice Int? @default(3800)
  basePairPrice    Int? @default(4800) // Cow & Calf Pair at single time service

  // Custom Gaushala Economics, Commission & Buffer Module
  partnershipTier  String? @default("STANDARD") // "PREFERRED" | "STANDARD" | "CHARITABLE" | "COMMERCIAL" | "CUSTOM"
  commissionType   String? @default("PERCENTAGE") // "PERCENTAGE" | "FIXED_PER_BOOKING" | "HYBRID"
  commissionValue  Float? // e.g. 8.0 for 8% preferred, or 400 for ₹400 flat
  taxTreatment     String? @default("STANDARD_GST") // "STANDARD_GST" | "SECTION_80G_EXEMPT" | "REDUCED_CHARITY_GST" | "CUSTOM_RATE"
  customTaxPct     Float? // e.g. 0.0 for exempt, 5.0 for concessional
  bufferMinutes    Int?    @default(30) // Turnaround/sanctuary buffer between bookings
  partnershipNotes String? // Rationale for special commission/tier
  metadata         Json?

  // Relationships
  animals     Animal[]
  managers    GosalaManagerAssignment[]
  bookings    Booking[]
  settlements SettlementBatch[]
  offerings   GosalaOffering[]
  vets        EmpanelledVet[]

  @@index([region])
  @@map("gosalas")
}

model GosalaManagerAssignment {
  id         String   @id @default(uuid())
  userId     String
  gosalaId   String
  region     String
  status     String   @default("Active") // "Active" | "Inactive"
  assignedAt DateTime @default(now())

  // Relationships
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gosala Gosala @relation(fields: [gosalaId], references: [id], onDelete: Cascade)

  @@unique([userId, gosalaId])
  @@index([gosalaId])
  @@map("gosala_manager_assignments")
}

model Animal {
  id           String       @id @default(uuid())
  gosalaId     String
  name         String
  type         AnimalType
  breed        String?
  ageYears     Int?
  healthStatus HealthStatus @default(HEALTHY)
  price        Int          @default(3500)
  isActive     Boolean      @default(true)
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relationships
  gosala         Gosala                @relation(fields: [gosalaId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  slotHolds      TemporarySlotHold[]
  scheduleBlocks AnimalScheduleBlock[]

  @@unique([gosalaId, name])
  @@index([gosalaId])
  @@index([type])
  @@map("animals")
}

// -------------------------------------------------------------
// Transactional Booking Entity (With Immutable Snapshots)
// -------------------------------------------------------------

model Booking {
  id         String  @id // "GMA-XXXXX"
  customerId String
  gosalaId   String
  animalId   String
  driverId   String?

  // Denormalized customer & animal display cache for performant retrieval
  customerName  String
  customerPhone String
  animalName    String
  animalType    AnimalType
  gosalaName    String

  // Slot timing & distance
  bookingDate String // "26 Sep 2026"
  startTime   String // "10:00"
  endTime     String // "12:00"
  durationMin Int // 120
  address     String
  distanceKm  Float

  // Financial Breakdown (All figures in INR whole currency)
  baseRate         Int
  extraTimeFee     Int
  transportFee     Int
  addonsFee        Int
  taxFee           Int
  discountFee      Int
  totalAmount      Int
  commissionPct    Float
  commissionAmount Int
  gosalaPayable    Int

  // Lifecycle & Field tracking
  status            BookingStatus @default(PAYMENT_VERIFIED)
  driverStage       Int           @default(0)
  isPaid            Boolean       @default(true)
  paymentProvider   String?       @default("RAZORPAY")
  paymentOrderId    String?
  paymentId         String?       @unique
  paymentStatus     String        @default("PENDING")
  paymentCapturedAt DateTime?
  walletTxId        String?

  // Anti-Corruption Historical Snapshots (Protection from retroactive master price shifts)
  freeKmSnapshot        Float @default(5.0)
  perKmSnapshot         Float @default(50.0)
  extraUnitRateSnapshot Int   @default(500)
  commissionSnapshot    Int   @default(0)

  // Review Remarks Cache
  managerRemark String?
  adminRemark   String?

  // Dynamic Customer Animal Received & Handover OTP Security
  handoverOtp           String?   @default("4819")
  handoverOtpVerified   Boolean   @default(false)
  handoverOtpVerifiedAt DateTime?

  // Rich Swiggy/Uber Driver Profile & Cattle Ambulance Specs
  driverPhone        String?
  driverVehiclePlate String?
  driverVehicleModel String?
  driverRating       Float?
  driverTotalTrips   Int?
  driverAvatar       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  customer        User                 @relation("CustomerBookings", fields: [customerId], references: [id])
  gosala          Gosala               @relation(fields: [gosalaId], references: [id])
  animal          Animal               @relation(fields: [animalId], references: [id])
  driver          User?                @relation("DriverBookings", fields: [driverId], references: [id])
  pricingConfigId Int?                 @default(1)
  pricingConfig   MasterPricingConfig? @relation(fields: [pricingConfigId], references: [id])
  auditTrails     ApprovalAuditTrail[]

  @@index([animalId, bookingDate, status])
  @@index([gosalaId, bookingDate])
  @@index([customerId])
  @@index([driverId])
  @@index([pricingConfigId])
  @@index([status])
  @@map("bookings")
}

// -------------------------------------------------------------
// Audit Trail & Governance (Immutable Ledger)
// -------------------------------------------------------------

model ApprovalAuditTrail {
  id        String      @id @default(uuid())
  bookingId String
  actorId   String
  actorRole UserRole
  actorName String
  action    AuditAction
  remark    String
  createdAt DateTime    @default(now())

  // Relationships
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id])

  @@index([bookingId])
  @@index([actorId])
  @@map("approval_audit_trails")
}

// -------------------------------------------------------------
// Concurrency & Operational Shield
// -------------------------------------------------------------

model TemporarySlotHold {
  id           String    @id // "HOLD-XXXXX"
  animalId     String
  date         String // "26 Sep 2026"
  startTime    String // "10:00"
  durationMin  Int // 60
  customerName String
  customerId   String?
  status       String    @default("ACTIVE") // ACTIVE | CONSUMED | RELEASED | EXPIRED
  consumedAt   DateTime?
  releasedAt   DateTime?
  expiresAt    DateTime // Epoch timestamp for TTL eviction
  createdAt    DateTime  @default(now())

  // Relationships
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  customer User?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([animalId, date, expiresAt])
  @@index([customerId, status, expiresAt])
  @@map("temporary_slot_holds")
}

model AnimalScheduleBlock {
  id          String   @id @default(uuid())
  animalId    String
  animalName  String
  date        String // "26 Sep 2026"
  timeSlot    String // "11:00"
  reason      String? // "Rest / Vet visit"
  blockedById String?
  createdAt   DateTime @default(now())

  // Relationships
  animal    Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  blockedBy User?  @relation(fields: [blockedById], references: [id], onDelete: SetNull)

  @@unique([animalId, date, timeSlot])
  @@index([animalId, date])
  @@map("animal_schedule_blocks")
}

// -------------------------------------------------------------
// Financial & Treasury Configuration (Super Admin Domain)
// -------------------------------------------------------------

model MasterPricingConfig {
  id                      Int      @id @default(1)
  standardMin             Int      @default(60)
  extraUnitMin            Int      @default(30)
  extraUnitRate           Int      @default(500)
  freeKm                  Float    @default(5.0)
  perKm                   Float    @default(50.0)
  taxPct                  Float    @default(12.0)
  commissionPct           Float    @default(20.0)
  maxDurationMin          Int      @default(240)
  bufferMin               Int      @default(30)
  rounding                String   @default("Nearest ₹10")
  samagriGaushalaCutPct   Float?   @default(90.0)
  transportPassThroughPct Float?   @default(100.0)
  autoSweepEnabled        Boolean? @default(true)
  disbursementCycle       String?  @default("CONTINUOUS_T_PLUS_ONE")
  autoSweepHour           Int?     @default(23)
  autoSweepMinute         Int?     @default(59)
  updatedByRole           String   @default("SUPER_ADMIN")
  updatedByName           String   @default("Vikramaditya Hegde")
  updatedAt               DateTime @updatedAt

  // Relationships
  bookings Booking[]

  @@map("master_pricing_config")
}

model GosalaOffering {
  id        String   @id @default(uuid())
  gosalaId  String
  name      String
  desc      String?
  price     Int
  category  String   @default("puja") // puja, feed, prasadam, decoration
  inStock   Boolean  @default(true)
  maxQty    Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  gosala Gosala @relation(fields: [gosalaId], references: [id], onDelete: Cascade)

  @@index([gosalaId])
  @@map("gosala_offerings")
}

model SettlementBatch {
  id               String           @id @default(uuid())
  gosalaId         String
  gosalaName       String
  batch            String // "SEP-W4"
  bookingsCount    Int
  grossAmount      Int
  commissionPct    Float
  commissionAmount Int
  payableAmount    Int
  status           SettlementStatus @default(PENDING)

  // Automated Banking Sweep Telemetry
  utrNumber         String?   @unique
  bankBeneficiary   String?
  bankName          String?
  accountMasked     String?
  ifscCode          String?
  payoutMode        String?   @default("RBI_RTGS")
  disbursedAt       DateTime?
  disbursementCycle String?   @default("CONTINUOUS_T_PLUS_ONE")
  idempotencyKey    String?   @unique
  failureReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  gosala Gosala @relation(fields: [gosalaId], references: [id], onDelete: Cascade)

  @@index([gosalaId, batch])
  @@index([status])
  @@map("settlement_batches")
}

// -------------------------------------------------------------
// Authentication, Password Recovery & Identity Verification
// -------------------------------------------------------------

model VerificationOtp {
  id          String    @id @default(uuid())
  identifier  String // normalized email or phone (+91...)
  otpHash     String // scrypt hash of the OTP
  channel     String    @default("EMAIL") // "EMAIL" | "PHONE"
  purpose     String    @default("PASSWORD_RESET") // "PASSWORD_RESET" | "REGISTRATION_VERIFY"
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  used        Boolean   @default(false)
  usedAt      DateTime?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([identifier, purpose, used])
  @@map("verification_otps")
}

// -------------------------------------------------------------
// Veterinary Welfare & Medical Directory
// -------------------------------------------------------------

model EmpanelledVet {
  id              String   @id @default(uuid())
  gosalaId        String?
  name            String
  qualification   String
  regNo           String   @unique
  clinic          String
  phone           String
  address         String
  specialization  String
  emergency24x7   Boolean  @default(true)
  assignedGosalas String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  gosala Gosala? @relation(fields: [gosalaId], references: [id], onDelete: SetNull)

  @@index([gosalaId])
  @@map("empanelled_vets")
}

// -------------------------------------------------------------
// Digital Wallet, Double-Entry Ledger & Payment Escrow Engine
// -------------------------------------------------------------

model Wallet {
  id           String     @id @default(uuid())
  kind         WalletKind @default(USER)
  systemKey    String?    @unique // ESCROW | PLATFORM | TAX | WITHDRAWAL_HOLD for system wallets
  userId       String?    @unique
  balancePaise BigInt     @default(0) // Integer paise to eliminate rounding errors (₹100.00 = 10000)
  currency     String     @default("INR")
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relationships
  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([userId])
  @@map("wallets")
}

model WalletTransaction {
  id             String                   @id @default(uuid())
  walletId       String
  amountPaise    BigInt // Always positive integer in paise
  type           WalletTransactionType
  purpose        WalletTransactionPurpose
  status         WalletTransactionStatus  @default(PENDING)
  balanceBefore  BigInt
  balanceAfter   BigInt
  idempotencyKey String                   @unique // Anti-replay & anti-double-spending shield
  referenceId    String? // e.g. paymentId, bookingId, settlementBatchId
  groupId        String? // entries that belong to one event (a release, a withdrawal)
  bookingId      String?
  description    String?
  metadata       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  // Relationships
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([referenceId])
  @@index([groupId])
  @@index([bookingId])
  @@index([purpose, status])
  @@map("wallet_transactions")
}

// -------------------------------------------------------------
// Commission settlement, split policy and withdrawals
// -------------------------------------------------------------

model WalletConfig {
  id                  Int      @id @default(1)
  platformBp          Int      @default(1000) // platform commission in basis points (1000 = 10%)
  settlementDelayDays Int      @default(2)
  updatedById         String?
  updatedAt           DateTime @updatedAt

  @@map("wallet_config")
}

// One approved policy per gaushala. policyKey "DEFAULT" applies to every gaushala without its own.
// The admin share is whatever is left after platform and manager shares.
model SplitPolicy {
  id           String   @id @default(uuid())
  policyKey    String   @unique
  gosalaId     String?
  managerBp    Int // manager share of the pre-tax amount, in basis points
  approvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("split_policies")
}

model SplitPolicyRequest {
  id                String             @id @default(uuid())
  policyKey         String
  gosalaId          String?
  gosalaName        String?
  currentManagerBp  Int?
  proposedManagerBp Int
  status            SplitRequestStatus @default(PENDING)
  requestedById     String
  requestedByName   String
  reason            String?
  decidedById       String?
  decidedByName     String?
  decisionNote      String?
  decidedAt         DateTime?
  createdAt         DateTime           @default(now())

  @@index([status])
  @@index([policyKey])
  @@map("split_policy_requests")
}

model BookingSettlement {
  id             String                  @id @default(uuid())
  bookingId      String                  @unique
  gosalaId       String
  gosalaName     String
  customerId     String
  grossPaise     BigInt // everything the customer paid, tax included
  taxPaise       BigInt // goes to the tax wallet
  platformPaise  BigInt
  adminPaise     BigInt
  managerPaise   BigInt
  platformBp     Int // percentages frozen at the moment of payment
  managerBp      Int
  adminBp        Int
  paymentSource  String // RAZORPAY | WALLET
  status         BookingSettlementStatus @default(HELD)
  paidAt         DateTime
  eligibleAt     DateTime
  readyAt        DateTime?
  decidedById    String?
  decidedByName  String?
  decidedAt      DateTime?
  decisionNote   String?
  releaseGroupId String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status, eligibleAt])
  @@index([gosalaId])
  @@map("booking_settlements")
}

model PayoutAccount {
  id                    String            @id @default(uuid())
  userId                String
  type                  PayoutAccountType
  holderName            String
  accountLast4          String?
  ifsc                  String?
  vpa                   String?
  accountNumberEnc      String? // full number kept only for the payout provider call
  providerContactId     String?
  providerFundAccountId String?
  isActive              Boolean           @default(true)
  usableFrom            DateTime // new accounts wait before they can receive money
  createdAt             DateTime          @default(now())

  @@index([userId])
  @@map("payout_accounts")
}

model WithdrawalRequest {
  id               String           @id @default(uuid())
  userId           String
  walletId         String
  payoutAccountId  String
  amountPaise      BigInt
  status           WithdrawalStatus @default(PROCESSING)
  mode             String           @default("SANDBOX") // SANDBOX | RAZORPAYX
  providerPayoutId String?
  utr              String?
  failureReason    String?
  idempotencyKey   String           @unique
  requestedAt      DateTime         @default(now())
  completedAt      DateTime?

  @@index([userId, requestedAt])
  @@index([status])
  @@map("withdrawal_requests")
}

model WithdrawalOtp {
  id              String   @id @default(uuid())
  userId          String
  otpHash         String
  amountPaise     BigInt
  payoutAccountId String
  attempts        Int      @default(0)
  used            Boolean  @default(false)
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([userId, used])
  @@map("withdrawal_otps")
}

model ProviderEvent {
  id          String   @id @default(uuid())
  provider    String
  eventId     String   @unique
  eventType   String
  payload     Json
  processedAt DateTime @default(now())

  @@map("provider_events")
}

// Who did what with money. Rows are only ever added.
model WalletAuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String
  actorRole  String
  action     String
  targetType String
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
  @@map("wallet_audit_logs")
}
